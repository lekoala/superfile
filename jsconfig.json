{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2020",
      "dom"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "superfile.js",
    "image.js",
    "previews.js",
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "superfile.min.js",
    "test"
  ]
}
