{
  "name": "superfile",
  "version": "2.0.0",
  "description": "A better native file input. Prepare files locally, submit with any HTML form.",
  "main": "./superfile.js",
  "scripts": {
    "build": "bun build ./superfile.js --target browser --minify --outfile ./superfile.min.js",
    "watch": "bun run build --watch",
    "start": "bun test/server.js",
    "test": "bun test",
    "test:browser": "bun ./node_modules/@playwright/test/cli.js test",
    "lint": "biome check src superfile.js image.js previews.js exif.js test/browser test/unit test/server.js playwright.config.js test/types superfile.d.ts image.d.ts previews.d.ts exif.d.ts",
    "prepack": "bun run build",
    "test:types": "tsc --project jsconfig.json && tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 --lib es2022,dom test/types/api.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lekoala/superfile"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.65.0",
    "piexifjs": "^1.0.6",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "file",
    "upload",
    "es6"
  ],
  "author": "LeKoala",
  "license": "MIT",
  "type": "module",
  "module": "./superfile.js",
  "exports": {
    ".": {
      "types": "./superfile.d.ts",
      "import": "./superfile.js",
      "default": "./superfile.js"
    },
    "./image": {
      "types": "./image.d.ts",
      "import": "./image.js",
      "default": "./image.js"
    },
    "./exif": {
      "types": "./exif.d.ts",
      "import": "./exif.js",
      "default": "./exif.js"
    },
    "./previews": {
      "types": "./previews.d.ts",
      "import": "./previews.js",
      "default": "./previews.js"
    }
  },
  "files": [
    "superfile.js",
    "superfile.min.js",
    "image.js",
    "exif.js",
    "previews.js",
    "src/",
    "docs/",
    "readme.md",
    "LICENSE",
    "superfile.d.ts",
    "image.d.ts",
    "exif.d.ts",
    "previews.d.ts"
  ],
  "types": "./superfile.d.ts"
}
